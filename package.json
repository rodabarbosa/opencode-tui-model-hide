  "keywords": [
    "opencode",
    "plugin",
    "opencode-plugin",
    "tui",
    "models",
    "hide-models"
  ],
  "license": "MIT",
  "author": "Rodrigo Araujo Barbosa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rodabarbosa/opencode-tui-model-hide.git"
  },
  "homepage": "https://github.com/rodabarbosa/opencode-tui-model-hide#readme",
  "bugs": {
    "url": "https://github.com/rodabarbosa/opencode-tui-model-hide/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.0",
    "@opentui/core": ">=0.6.6",
