  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode/plugin": "2.2.5",
    "@opentui/core": "0.8.0",
    "@opentui/solid": "0.8.0",
    "@types/node": "^26.6.6",
    "solid-js": "1.9.17",
    "typescript": "^5.9.0"
  },
  "scripts": {
